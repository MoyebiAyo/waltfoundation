{
  "name": "walts-foundation",
  "version": "1.0.0",
  "private": true,
  "description": "Walts Charity and Empowerment Foundation — static website",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/site.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/site.css --watch",
    "images": "node scripts/optimize-images.js",
    "build": "npm run images && npm run build:css",
    "dev": "npm run watch:css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "sharp": "^0.33.5"
  }
}